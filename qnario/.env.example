# ============================================================
#  QNARIO - Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit the actual .env file to git!
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/qnario

# JWT (use a strong random string - at least 32 characters)
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_STRING_HERE

# AI Microservice
AI_MICROSERVICE_URL=http://localhost:5000

# Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Email (for forgot-password feature)
EMAIL_USER=your@email.com
EMAIL_PASSWORD=your_email_app_password

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
