# ============================================================
#  QNARIO AI SERVICE - Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit the actual .env file to git!
# ============================================================

# API Credentials for AI Models
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_MODEL_NAME=gemini-flash-latest


# Microservice Network Port
PYTHON_PORT=5000

# Backend Connection URL (for callbacks or webhooks if needed)
NODE_SERVER_URL=http://server:3000

# System mode (development/production)
DEBUG=True
