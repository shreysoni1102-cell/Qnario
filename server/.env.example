# ============================================================
#  QNARIO SERVER - Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit the actual .env file to git!
# ============================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection
MONGODB_URI=mongodb://mongodb:27017/qnario

# JWT Security Credentials (use a strong random string)
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_STRING_HERE
JWT_EXPIRES_IN=7d

# AI FastAPI Microservice Connection
AI_MICROSERVICE_URL=http://ai-service:5000

# Groq API Configuration (for backup models)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Email SMTP Services (for password resets)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_specific_password

# CORS Allowed Origins
FRONTEND_URL=http://localhost:5173
